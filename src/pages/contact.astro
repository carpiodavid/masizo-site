---
/**
 * /contact — built from content/pages/contact.md.
 * Lead form per functions/api/lead.ts contract: name* + phone* (required),
 * city + service selects from business.ts, message, hidden `company`
 * honeypot. SMS-consent disclosure (from the .md) renders beneath the
 * submit button. On success: masizoTrack("lead_submit", {service}) then
 * redirect to /thank-you. No-JS fallback: a normal POST to /api/lead.
 * On failure the phone number is shown — never a dead end.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import Hero from "../components/ui/Hero.astro";
import Section from "../components/ui/Section.astro";
import TrustStrip from "../components/ui/TrustStrip.astro";
import StickyCallBar from "../components/ui/StickyCallBar.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Prose from "../components/Prose.astro";
import { CITIES, PHONE_DISPLAY, PHONE_TEL, SERVICES } from "../data/business";
import { breadcrumbNode } from "../components/schema-nodes";
import { crumbsForNav, crumbsForSchema, loadPage } from "../lib/content";

const page = loadPage("contact.md");

// The single H2 section ("What Happens Next") carries, in order: two
// what-happens paragraphs, the SMS consent disclosure, and the closing
// maps/reviews paragraph. Split them out for placement.
const nextSec = page.sections[0];
const paragraphs = [...nextSec.html.matchAll(/<p>[\s\S]*?<\/p>/g)].map((m) => m[0]);
const disclosureHtml = paragraphs.find((p) => p.includes("SMS consent disclosure")) ?? "";
const closingHtml = paragraphs[paragraphs.length - 1] ?? "";
const whatNextHtml = paragraphs
  .filter((p) => p !== disclosureHtml && p !== closingHtml)
  .join("\n");

const schema = [breadcrumbNode(crumbsForSchema(page.data.breadcrumbs))];
---

<Base title={page.title} description={page.description} schema={schema}>
  <Header />
  <main id="main">
    <div class="crumb-band">
      <div class="container-wide">
        <Breadcrumbs items={crumbsForNav(page.data.breadcrumbs)} />
      </div>
    </div>

    <Hero variant="service" tone="bone" eyebrow="Free estimates · 24/7 emergency line" title={page.h1 ?? "Contact"} phone={true}>
      <div class="lede-stack" set:html={page.introHtml} />
    </Hero>

    <TrustStrip tone="bone" />

    <Section tone="sand" eyebrow="Send the details" title="About a minute of typing.">
      <div class="contact-grid">
        <form class="lead-form reveal" id="lead-form" method="POST" action="/api/lead">
          <div class="field">
            <label for="lead-name">Name <span aria-hidden="true">*</span></label>
            <input id="lead-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="lead-phone">Phone <span aria-hidden="true">*</span></label>
            <input id="lead-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="lead-city">City</label>
              <select id="lead-city" name="city">
                <option value="">Select a city…</option>
                {CITIES.map((city) => <option value={city.name}>{city.name}</option>)}
                <option value="Other / nearby">Other / nearby</option>
              </select>
            </div>
            <div class="field">
              <label for="lead-service">Service</label>
              <select id="lead-service" name="service">
                <option value="">What's the project?</option>
                {SERVICES.map((service) => <option value={service.name}>{service.name}</option>)}
                <option value="Something else">Something else</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="lead-message">A sentence or two about the project</label>
            <textarea id="lead-message" name="message" rows="5"></textarea>
          </div>

          <!-- Honeypot (lead.ts contract): humans never see or fill this. -->
          <div class="hp-field" aria-hidden="true">
            <label for="lead-company">Company</label>
            <input id="lead-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="form-error" id="lead-error" hidden>
            Something went wrong sending the form — please call
            <a href={PHONE_TEL}>{PHONE_DISPLAY}</a> instead. We answer.
          </p>

          <button class="btn btn-clay form-submit" type="submit">Send — get a free estimate</button>

          <div class="disclosure" set:html={disclosureHtml} />
        </form>

        <aside class="contact-aside reveal">
          <h2 class="aside-title">What happens next</h2>
          <Prose html={whatNextHtml} />
        </aside>
      </div>
    </Section>

    <Section eyebrow="Find us" title="See who you're dealing with." tight>
      <div class="reveal">
        <Prose html={closingHtml} />
      </div>
    </Section>
  </main>
  <Footer />
  <StickyCallBar />
</Base>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const errorBox = document.getElementById("lead-error");
    if (errorBox) errorBox.hidden = true;
    const data = new FormData(form);
    if (button) {
      button.disabled = true;
      button.textContent = "Sending…";
    }
    try {
      const response = await fetch(form.action, { method: "POST", body: data });
      const result = (await response.json().catch(() => ({ ok: false }))) as { ok?: boolean };
      if (!response.ok || !result.ok) throw new Error("lead submit failed");
      (window as any).masizoTrack?.("lead_submit", { service: String(data.get("service") || "(not set)") });
      window.location.href = "/thank-you";
    } catch {
      if (errorBox) errorBox.hidden = false;
      if (button) {
        button.disabled = false;
        button.textContent = "Send — get a free estimate";
      }
    }
  });
</script>

<style>
  .crumb-band {
    padding-top: var(--space-5);
  }
  :global(.lede-stack p + p) {
    margin-top: var(--space-4);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7) var(--space-8);
    align-items: start;
  }
  @media (max-width: 899px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .lead-form {
    background: var(--c-bone);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    display: grid;
    gap: var(--space-5);
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 639px) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .field label {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .field label span {
    color: var(--c-clay);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7em 0.85em;
    font-size: var(--text-base);
    color: var(--c-ink);
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-xs);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 1px;
  }

  /* Honeypot: rendered off-screen, never display:none (bots check). */
  .hp-field {
    position: absolute !important;
    left: -9999px !important;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--c-clay);
    background: var(--c-clay-wash);
    font-weight: 560;
  }
  .form-submit {
    justify-self: start;
    font-size: var(--text-base);
  }
  @media (max-width: 639px) {
    .form-submit {
      justify-self: stretch;
      width: 100%;
    }
  }
  .disclosure :global(p) {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--c-ink-soft);
    max-width: 62ch;
  }

  .aside-title {
    font-size: var(--text-2xl);
  }
  .contact-aside :global(.prose) {
    margin-top: var(--space-4);
    color: var(--c-ink-soft);
  }
</style>

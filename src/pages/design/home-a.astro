---
/**
 * DESIGN COMP A — "High Desert Editorial"
 * Bone canvas, serif-led magazine layout: oversized Fraunces headline with an
 * offset portrait-crop photo, ledger-row services index, agave process band,
 * clay emergency moment. Quietest and most editorial of the three.
 * Copy is minimal placeholder — content agent owns final words.
 */
import Base from "../../layouts/Base.astro";
import Header from "../../components/ui/Header.astro";
import Footer from "../../components/ui/Footer.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import ServiceCard from "../../components/ui/ServiceCard.astro";
import TrustStrip from "../../components/ui/TrustStrip.astro";
import FAQ from "../../components/ui/FAQ.astro";
import ReviewExcerpt from "../../components/ui/ReviewExcerpt.astro";
import CTABand from "../../components/ui/CTABand.astro";
import StickyCallBar from "../../components/ui/StickyCallBar.astro";
import PhotoPlaceholder from "../../components/ui/PhotoPlaceholder.astro";
import {
  CITIES,
  DISPLAY_NAME,
  LICENSES,
  PHONE_DISPLAY,
  PHONE_TEL,
  SERVICES,
  SINCE_YEAR,
  YEARS_IN_BUSINESS,
} from "../../data/business";

const blurbs: Record<string, string> = {
  "custom-homes": "Ground-up builds, from first drawing to final walkthrough.",
  "home-remodeling": "Whole-home transformations, structure to finish.",
  "kitchen-remodeling": "Cabinetry, counters, lighting — the room you live in.",
  "bathroom-remodeling": "Showers, tile, vanities, ventilation done right.",
  "room-additions": "More house on the house you already love.",
  "adu-construction": "Permitted ADUs and casitas, zoning to buildout.",
  "roofing": "Replacement, repair, and inspections for desert roofs.",
  "restoration": "Water, mold, and fire response — around the clock.",
  "commercial": "Commercial GC and tenant improvement work.",
};

const faqs = [
  {
    q: "Which cities do you serve?",
    answerHtml:
      "<p>We work across the Phoenix East Valley — Gilbert, Mesa, Chandler, Queen Creek, and the surrounding metro. [CONTENT: full answer — content agent]</p>",
  },
  {
    q: "Are estimates free?",
    answerHtml: "<p>[CONTENT: free on-site consultation answer — content agent]</p>",
  },
  {
    q: "Are you licensed and insured?",
    answerHtml:
      `<p>Yes — ${LICENSES.map((l) => l.label).join(", ")}. [CONTENT: expand — content agent]</p>`,
  },
];

const stats = [
  { n: String(YEARS_IN_BUSINESS), label: `Years building Arizona, since ${SINCE_YEAR}` },
  { n: String(LICENSES.length), label: "Contractor licenses, AZ & CA" },
  { n: String(CITIES.length), label: "East Valley & Phoenix cities served" },
];
---

<Base
  title={`${DISPLAY_NAME} | Design comp A — High Desert Editorial`}
  noindex={true}
>
  <Header />
  <main id="main">
    <Hero variant="home" tone="bone" eyebrow={`Gilbert, Arizona · Since ${SINCE_YEAR}`} phone={true}>
      <h1 slot="heading" class="hero-title-a">
        A builder for <em>every phase</em> of your home.
      </h1>
      <p>
        Custom homes, full remodels, ADUs, roofing — and 24/7 restoration when
        the unexpected happens. One licensed Gilbert contractor,
        {YEARS_IN_BUSINESS} years in.
      </p>
      <a slot="actions" class="link-arrow" href="/portfolio">
        View our work
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <PhotoPlaceholder
        slot="media"
        label="finished custom home exterior, golden hour, Gilbert"
        ratio="3/4"
        tone="clay"
        class="hero-photo-a reveal"
      />
    </Hero>

    <TrustStrip tone="bone" />

    <Section id="about" eyebrow="Who we are" title="One crew, first walkthrough to final punch list." tone="sand">
      <div class="about-grid">
        <div class="about-copy reveal">
          <p>
            Masizo Development &amp; Restorations is a licensed Arizona general
            contractor and IICRC-certified restoration firm. We build, remodel,
            and restore East Valley homes — and we answer when water, mold, or
            fire won't wait. [CONTENT: about band — content agent]
          </p>
        </div>
        <dl class="about-stats">
          {
            stats.map((s) => (
              <div class="stat reveal">
                <dd class="stat-n numeral">{s.n}</dd>
                <dt class="stat-label">{s.label}</dt>
              </div>
            ))
          }
        </dl>
        <PhotoPlaceholder
          label="Masizo team on a job site"
          ratio="16/9"
          tone="agave"
          class="about-photo reveal"
        />
      </div>
    </Section>

    <Section eyebrow="What we do" title="Nine trades. One contractor.">
      <a slot="action" class="link-arrow" href="/services">
        All services
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <div class="svc-list reveal">
        {
          SERVICES.map((s, i) => (
            <ServiceCard
              title={s.name}
              href={s.path}
              blurb={blurbs[s.slug]}
              index={String(i + 1).padStart(2, "0")}
              emergency={s.emergency}
            />
          ))
        }
      </div>
    </Section>

    <Section eyebrow="How it works" title="From first call to final walkthrough." tone="agave">
      <ol class="process">
        {
          [
            { t: "Walk the site", d: "A free on-site consultation — we look, listen, and measure before we talk numbers. [CONTENT]" },
            { t: "Scope in writing", d: "A written proposal with scope, timeline, and pricing you can hold us to. [CONTENT]" },
            { t: "We run the build", d: "Permits, inspections, trades, and communication — handled under one roof. [CONTENT]" },
          ].map((step, i) => (
            <li class="process-step reveal">
              <span class="process-n numeral" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="process-t">{step.t}</h3>
              <p class="process-d">{step.d}</p>
            </li>
          ))
        }
      </ol>
    </Section>

    <Hero variant="emergency" tone="clay" eyebrow="24/7 restoration" title="Water where it shouldn't be? Call now.">
      <p>
        Our restoration crews respond to water, mold, and fire emergencies
        around the clock — and we work with your insurance.
        [CONTENT: emergency copy — gated on §7 verify]
      </p>
      <a slot="actions" class="link-arrow" href="/services/restoration">
        How restoration works
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
    </Hero>

    <Section eyebrow="In their words" title="Neighbors who called us first.">
      <a slot="action" class="link-arrow" href="/testimonials">
        All reviews
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <div class="reviews-grid">
        <div class="reveal">
          <ReviewExcerpt
            quote="[REVIEW: verbatim Google review #1 — content agent inserts real, attributed quote]"
            author="[Reviewer name]"
          />
        </div>
        <div class="reveal">
          <ReviewExcerpt
            quote="[REVIEW: verbatim Google review #2 — content agent inserts real, attributed quote]"
            author="[Reviewer name]"
          />
        </div>
      </div>
    </Section>

    <Section eyebrow="Good to know" title="Questions homeowners ask." tone="sand">
      <div class="faq-wrap reveal">
        <FAQ items={faqs} />
      </div>
    </Section>

    <CTABand />
  </main>
  <Footer />
  <StickyCallBar />
</Base>

<style>
  .hero-title-a {
    margin-top: var(--space-4);
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    max-width: 14ch;
  }
  .hero-title-a em {
    font-style: italic;
    font-weight: 440;
    color: var(--c-clay-deep);
  }
  :global(.hero-photo-a) {
    max-width: 26rem;
    margin-left: auto;
  }
  @media (max-width: 899px) {
    :global(.hero-photo-a) {
      max-width: 100%;
      aspect-ratio: 16 / 10 !important;
      margin-left: 0;
    }
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6) var(--space-8);
    align-items: start;
  }
  .about-copy p {
    font-size: var(--text-lg);
    max-width: 52ch;
    color: var(--c-ink-soft);
  }
  .about-stats {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
  }
  .stat {
    padding-top: var(--space-4);
    border-top: 1px solid var(--c-line);
  }
  .stat-n { font-size: var(--text-4xl); }
  .stat-label {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 560;
    color: var(--c-ink-soft);
  }
  @media (max-width: 767px) {
    .about-grid { grid-template-columns: minmax(0, 1fr); }
    .about-stats { grid-row: auto; gap: var(--space-4); }
  }

  .svc-list { border-top: 1px solid var(--c-line); }

  .process {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .process-step {
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-line-on-dark);
  }
  .process-n {
    display: block;
    font-size: var(--text-4xl);
    color: var(--c-accent-on-dark);
  }
  .process-t {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
  }
  .process-d {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    color: var(--c-mut-on-dark);
    max-width: 36ch;
  }
  @media (max-width: 767px) {
    .process { grid-template-columns: minmax(0, 1fr); }
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7);
  }
  @media (max-width: 767px) {
    .reviews-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  }

  .faq-wrap { max-width: 50rem; }
</style>

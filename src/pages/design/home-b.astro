---
/**
 * DESIGN COMP B — "Ironwood Ledger"
 * Committed deep-agave hero with drafting-table structure: ruled grid lines,
 * tabular stat ledger, numbered service index with scope bullets, horizontal
 * process rail. The most architectural/technical of the three directions.
 * Copy is minimal placeholder — content agent owns final words.
 */
import Base from "../../layouts/Base.astro";
import Header from "../../components/ui/Header.astro";
import Footer from "../../components/ui/Footer.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import ServiceCard from "../../components/ui/ServiceCard.astro";
import TrustStrip from "../../components/ui/TrustStrip.astro";
import FAQ from "../../components/ui/FAQ.astro";
import ReviewExcerpt from "../../components/ui/ReviewExcerpt.astro";
import CTABand from "../../components/ui/CTABand.astro";
import StickyCallBar from "../../components/ui/StickyCallBar.astro";
import PhotoPlaceholder from "../../components/ui/PhotoPlaceholder.astro";
import {
  CITIES,
  DISPLAY_NAME,
  LICENSES,
  SERVICES,
  SINCE_YEAR,
  YEARS_IN_BUSINESS,
} from "../../data/business";

const scope: Record<string, string[]> = {
  "custom-homes": ["Design-to-build", "Permits & inspections", "Finish carpentry"],
  "home-remodeling": ["Structural changes", "Layout & systems", "Full finish"],
  "kitchen-remodeling": ["Cabinetry & counters", "Electrical", "Lighting & tile"],
  "bathroom-remodeling": ["Showers & tubs", "Tile & vanities", "Plumbing & vent"],
  "room-additions": ["Foundations", "Framing & roof tie-in", "HVAC & finish"],
  "adu-construction": ["Zoning & permits", "Detached or attached", "Interior buildout"],
  "roofing": ["Replacement", "Tile, shingle & flat", "Leak repair"],
  "restoration": ["Water & flood", "Mold remediation", "Fire & smoke"],
  "commercial": ["Commercial GC", "Tenant improvement", "Emergency response"],
};

const ledger = [
  { n: String(YEARS_IN_BUSINESS), unit: "yrs", label: `Building Arizona since ${SINCE_YEAR}` },
  { n: String(LICENSES.length), unit: "lic", label: "AZ ROC ×2 + CA CSLB" },
  { n: String(CITIES.length), unit: "cities", label: "East Valley & Phoenix metro" },
  { n: "24/7", unit: "", label: "Restoration response, every day" },
];

const faqs = [
  {
    q: "Do you handle the permits?",
    answerHtml: "<p>[CONTENT: permits answer — content agent]</p>",
  },
  {
    q: "How long will my project take?",
    answerHtml: "<p>[CONTENT: timeline answer (bath = weeks, custom home = months) — content agent]</p>",
  },
  {
    q: "Which licenses do you hold?",
    answerHtml: `<p>${LICENSES.map((l) => l.label).join(" · ")}. [CONTENT: expand — content agent]</p>`,
  },
];
---

<Base
  title={`${DISPLAY_NAME} | Design comp B — Ironwood Ledger`}
  noindex={true}
>
  <Header />
  <main id="main">
    <div class="hero-wrap-b">
      <Hero variant="home" tone="agave" eyebrow="Licensed general contractor — Gilbert, AZ" phone={true}>
        <h1 slot="heading" class="hero-title-b">
          Build it. Remodel it.<br />
          <span class="hero-title-accent">Restore it at 2 a.m.</span>
        </h1>
        <p>
          {YEARS_IN_BUSINESS} years of custom homes, remodels, and roofing in
          the East Valley — with restoration crews on call around the clock.
        </p>
        <a slot="actions" class="btn btn-outline-dark" href="/services">Our services</a>
        <PhotoPlaceholder
          slot="media"
          label="framing crew raising a wall, blue sky"
          ratio="4/3"
          tone="sand"
          class="reveal"
        />
        <dl slot="below" class="ledger reveal">
          {
            ledger.map((row) => (
              <div class="ledger-cell">
                <dd class="ledger-n tabular">
                  {row.n}
                  {row.unit && <span class="ledger-unit">{row.unit}</span>}
                </dd>
                <dt class="ledger-label">{row.label}</dt>
              </div>
            ))
          }
        </dl>
      </Hero>
    </div>

    <TrustStrip tone="bone" flush />

    <Section eyebrow="Service index" title="The full scope, under one license.">
      <a slot="action" class="link-arrow" href="/services">
        All services
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <div class="svc-list reveal">
        {
          SERVICES.map((s, i) => (
            <ServiceCard
              title={s.name}
              href={s.path}
              bullets={scope[s.slug]}
              index={String(i + 1).padStart(2, "0")}
              emergency={s.emergency}
            />
          ))
        }
      </div>
    </Section>

    <Section eyebrow="Recent work" title="Job sites, not stock photos." tone="sand" wide>
      <a slot="action" class="link-arrow" href="/portfolio">
        The portfolio
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <div class="work-grid">
        <PhotoPlaceholder label="kitchen remodel, finished — Mesa" ratio="4/3" tone="clay" class="reveal" />
        <PhotoPlaceholder label="ADU exterior, completed — Gilbert" ratio="3/4" tone="agave" class="reveal" />
        <PhotoPlaceholder label="tile roof replacement in progress" ratio="4/3" tone="stone" class="reveal" />
      </div>
    </Section>

    <Section eyebrow="How it works" title="Three steps. No surprises.">
      <ol class="rail">
        {
          [
            { t: "Site consultation", d: "Free, on-site, no obligation. [CONTENT]" },
            { t: "Written scope & price", d: "Scope, timeline, and pricing in writing. [CONTENT]" },
            { t: "Managed build", d: "Permits, trades, and inspections — ours to run. [CONTENT]" },
          ].map((step, i) => (
            <li class="rail-step reveal">
              <span class="rail-n tabular" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="rail-t">{step.t}</h3>
              <p class="rail-d">{step.d}</p>
            </li>
          ))
        }
      </ol>
    </Section>

    <CTABand
      tone="clay"
      eyebrow="24/7 emergency"
      title="Water, mold, or fire? Crews are on call right now."
      secondaryHref="/services/restoration"
      secondaryLabel="Restoration services"
    />

    <Section eyebrow="In their words" title="What homeowners say.">
      <a slot="action" class="link-arrow" href="/testimonials">
        All reviews
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"
          ><path d="M3 10h13M11 4.5 16.5 10 11 15.5"></path></svg
        >
      </a>
      <div class="review-solo reveal">
        <ReviewExcerpt
          quote="[REVIEW: verbatim Google review — content agent inserts real, attributed quote]"
          author="[Reviewer name]"
        />
      </div>
    </Section>

    <Section eyebrow="Good to know" title="Before you call." tone="sand">
      <div class="faq-wrap reveal">
        <FAQ items={faqs} />
      </div>
    </Section>

    <CTABand tone="ink" eyebrow="Start the conversation" title="Walk us through the project. We'll walk the site." />
  </main>
  <Footer />
  <StickyCallBar />
</Base>

<style>
  /* Drafting-grid texture behind the agave hero */
  .hero-wrap-b :global(.hero) {
    background-image:
      linear-gradient(to right, rgba(246, 240, 228, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(246, 240, 228, 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
  }
  .hero-title-b {
    margin-top: var(--space-4);
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
  }
  .hero-title-accent {
    font-style: italic;
    font-weight: 420;
    color: var(--c-accent-on-dark);
  }

  .ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-line-on-dark);
  }
  .ledger-n {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 440;
    line-height: 1;
    color: var(--c-bone-on-dark);
  }
  .ledger-unit {
    font-size: 0.45em;
    font-family: var(--font-text);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-accent-on-dark);
    margin-left: 0.3em;
  }
  .ledger-label {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 560;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-mut-on-dark);
  }
  @media (max-width: 767px) {
    .ledger { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .svc-list { border-top: 1px solid var(--c-line); }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
    gap: var(--space-4);
    align-items: end;
  }
  @media (max-width: 767px) {
    .work-grid { grid-template-columns: minmax(0, 1fr); }
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail-step {
    position: relative;
    padding-top: var(--space-5);
    border-top: 2px solid var(--c-clay);
  }
  .rail-n {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--c-clay-deep);
  }
  .rail-t { margin-top: var(--space-3); font-size: var(--text-xl); }
  .rail-d {
    margin-top: var(--space-2);
    color: var(--c-ink-soft);
    max-width: 34ch;
  }
  @media (max-width: 767px) {
    .rail { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  }

  .review-solo { max-width: 46rem; }
  .faq-wrap { max-width: 50rem; }
</style>

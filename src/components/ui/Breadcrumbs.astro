---
/**
 * Breadcrumbs — visible crumb trail. Items: [{ label, href? }]; the last
 * item (current page) usually has no href. Pages pair this with
 * breadcrumbNode(...) from schema-nodes.ts for BreadcrumbList JSON-LD.
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  tone?: "light" | "dark";
}
const { items, tone = "light" } = Astro.props;
---

<nav class:list={["crumbs", `crumbs-${tone}`]} aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {i < items.length - 1 && (
            <svg class="crumb-sep" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M4.5 2.5 8 6l-3.5 3.5" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .crumbs a { text-decoration: none; }
  .crumbs-light a { color: var(--c-ink-soft); }
  .crumbs-light a:hover { color: var(--c-clay-deep); }
  .crumbs-light span[aria-current] { color: var(--c-clay-deep); }
  .crumbs-light .crumb-sep { color: var(--c-line); }
  .crumbs-dark a { color: var(--c-mut-on-dark); }
  .crumbs-dark a:hover { color: var(--c-bone-on-dark); }
  .crumbs-dark span[aria-current] { color: var(--c-accent-on-dark); }
  .crumbs-dark .crumb-sep { color: var(--c-line-on-dark); }
  .crumb-sep { width: 0.6rem; height: 0.6rem; }
</style>

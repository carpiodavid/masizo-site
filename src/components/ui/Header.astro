---
/**
 * Header — sitewide. Nav per docs/recon/internal-link-map.md:
 * Services (dropdown: /services + all 9 service pages from business.ts),
 * Service Areas, Portfolio, Reviews, Guide, Contact + prominent call CTA.
 * "About Us" is intentionally NOT in the nav (no /about in the IA; the
 * homepage carries an #about band — see DECISIONS.md).
 *
 * Emergency path: slim agave utility strip on top links /services/restoration
 * (always visible, handoff §5.3 — copy avoids the unverified "live answer"
 * promise).
 *
 * Accessibility: disclosure buttons with aria-expanded/aria-controls,
 * Escape + outside-click close, no JS framework (small vanilla script).
 *
 * Slot "logo": replace the default typographic wordmark with the client
 * logo when it arrives.
 */
import {
  DISPLAY_NAME,
  PHONE_DISPLAY,
  PHONE_TEL,
  SERVICES,
} from "../../data/business";

const navServices = SERVICES;
const links = [
  { label: "Service Areas", href: "/service-areas" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Reviews", href: "/testimonials" },
  { label: "ADU Guide", href: "/guides/arizona-adu-law" },
  { label: "Contact", href: "/contact" },
];
---

<div class="emergency-strip tone-agave on-dark">
  <div class="container-wide strip-inner">
    <a class="strip-link" href="/services/restoration">
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
        ><path
          d="M8 1.2c2.5 3.1 4.6 5.5 4.6 8.2a4.6 4.6 0 0 1-9.2 0C3.4 6.7 5.5 4.3 8 1.2Zm0 11.4a3.1 3.1 0 0 0 3.1-3.2c0-.5-.1-1-.3-1.5A3.4 3.4 0 0 1 8 9.4a3.4 3.4 0 0 1-2.8-1.5c-.2.5-.3 1-.3 1.5A3.1 3.1 0 0 0 8 12.6Z"
        ></path></svg
      >
      <span>24/7 emergency water, mold &amp; fire restoration</span>
    </a>
    <a class="strip-phone" href={PHONE_TEL}>{PHONE_DISPLAY}</a>
  </div>
</div>

<header class="site-header" id="site-header">
  <div class="container-wide header-inner">
    <a class="wordmark" href="/" aria-label={`${DISPLAY_NAME} — home`}>
      <slot name="logo">
        <span class="wordmark-name">Masizo</span>
        <span class="wordmark-sub">Development &amp; Restorations</span>
      </slot>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-list">
        <li class="nav-item has-sub">
          <button
            type="button"
            class="nav-link nav-sub-toggle"
            aria-expanded="false"
            aria-controls="submenu-services"
          >
            Services
            <svg viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"
              ><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg
            >
          </button>
          <ul class="submenu" id="submenu-services">
            <li><a class="submenu-link submenu-all" href="/services">All services</a></li>
            {
              navServices.map((s) => (
                <li>
                  <a class="submenu-link" href={s.path}>
                    {s.emergency ? "Restoration (24/7)" : s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          links.map((l) => (
            <li class="nav-item">
              <a class="nav-link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn-clay header-call" href={PHONE_TEL}>
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
        ><path
          d="M3.7 1.6c.4-.4 1-.4 1.4 0l1.8 1.9c.4.4.4 1 0 1.4l-.9.9a.6.6 0 0 0-.1.7 9.6 9.6 0 0 0 3.6 3.6c.2.1.5.1.7-.1l.9-.9c.4-.4 1-.4 1.4 0l1.9 1.8c.4.4.4 1 0 1.4l-1 1.1c-.6.6-1.5.8-2.3.6C8.7 13 5.9 11.3 4 9.4 2 7.5.5 5.3 1 3.6c.2-.8 1-1.4 1.6-2l1.1 0Z"
        ></path></svg
      >
      <span>{PHONE_DISPLAY}</span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="visually-hidden">Menu</span>
      <svg class="icon-open" viewBox="0 0 20 20" aria-hidden="true" stroke="currentColor" stroke-width="1.6" fill="none"
        ><path d="M2 5.5h16M2 10h16M2 14.5h16"></path></svg
      >
      <svg class="icon-close" viewBox="0 0 20 20" aria-hidden="true" stroke="currentColor" stroke-width="1.6" fill="none"
        ><path d="M4 4l12 12M16 4 4 16"></path></svg
      >
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Primary" hidden>
    <div class="container mobile-menu-inner">
      <p class="mobile-group-label">Services</p>
      <ul class="mobile-list">
        <li><a href="/services">All services</a></li>
        {
          navServices.map((s) => (
            <li>
              <a href={s.path}>{s.emergency ? "Restoration (24/7)" : s.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="mobile-group-label">Company</p>
      <ul class="mobile-list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="btn btn-clay mobile-call" href={PHONE_TEL}>Call {PHONE_DISPLAY}</a>
    </div>
  </nav>
</header>

<style>
  .emergency-strip {
    font-size: var(--text-xs);
  }
  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0.45rem;
  }
  .strip-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--c-bone-on-dark);
    text-decoration: none;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .strip-link svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--c-accent-on-dark);
  }
  .strip-link:hover { color: var(--c-accent-on-dark); }
  .strip-phone {
    color: var(--c-accent-on-dark);
    text-decoration: none;
    font-weight: 650;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .strip-phone:hover { color: var(--c-bone-on-dark); }
  @media (max-width: 719px) {
    .strip-phone { display: none; }
    .strip-link { letter-spacing: 0.02em; }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--c-bone) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 4.25rem;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    color: var(--c-ink);
    line-height: 1;
  }
  .wordmark:hover { color: var(--c-ink); }
  .wordmark-name {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: 1.55rem;
    letter-spacing: 0.01em;
  }
  .wordmark-sub {
    font-size: 0.56rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-clay-deep);
  }

  .nav-desktop { margin-left: auto; }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item { position: relative; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.55rem 0.65rem;
    font-size: var(--text-sm);
    font-weight: 560;
    color: var(--c-ink);
    text-decoration: none;
    background: none;
    border: 0;
    border-radius: var(--radius-xs);
    cursor: pointer;
  }
  .nav-link:hover { color: var(--c-clay-deep); }
  .nav-link svg { width: 0.7em; height: 0.7em; }
  .nav-sub-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

  .submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 15rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--c-bone);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    display: none;
  }
  .nav-item.has-sub.open .submenu { display: block; }
  .submenu-link {
    display: block;
    padding: 0.45rem 0.65rem;
    font-size: var(--text-sm);
    color: var(--c-ink);
    text-decoration: none;
    border-radius: var(--radius-xs);
  }
  .submenu-link:hover { background: var(--c-sand); color: var(--c-ink); }
  .submenu-all {
    font-weight: 650;
    color: var(--c-clay-deep);
    border-bottom: 1px solid var(--c-line);
    border-radius: 0;
    margin-bottom: 0.25rem;
  }

  .header-call { white-space: nowrap; }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    background: none;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-xs);
    color: var(--c-ink);
    cursor: pointer;
  }
  .menu-toggle svg { width: 1.25rem; height: 1.25rem; }
  .menu-toggle .icon-close { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-open { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-close { display: block; }

  .mobile-menu {
    border-top: 1px solid var(--c-line);
    background: var(--c-bone);
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
  }
  .mobile-menu-inner { padding-block: var(--space-5) var(--space-6); }
  .mobile-group-label {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--c-clay-deep);
  }
  .mobile-group-label:first-child { margin-top: 0; }
  .mobile-list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }
  .mobile-list a {
    display: block;
    padding: 0.6rem 0;
    font-size: var(--text-base);
    font-weight: 560;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-line);
  }
  .mobile-call {
    width: 100%;
    margin-top: var(--space-5);
  }

  @media (max-width: 1023px) {
    .nav-desktop { display: none; }
    .header-call { display: none; }
    .menu-toggle { display: inline-flex; }
  }
  @media (min-width: 1024px) {
    .mobile-menu { display: none; }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    // Services dropdown (desktop)
    const sub = header.querySelector(".nav-sub-toggle");
    const subItem = sub?.closest(".has-sub");
    sub?.addEventListener("click", () => {
      const open = subItem?.classList.toggle("open");
      sub.setAttribute("aria-expanded", open ? "true" : "false");
    });

    // Mobile menu
    const toggle = header.querySelector(".menu-toggle");
    const menu = document.getElementById("mobile-menu");
    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
      if (menu) menu.hidden = isOpen;
    });

    // Close on Escape / outside click
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      subItem?.classList.remove("open");
      sub?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-expanded", "false");
      if (menu) menu.hidden = true;
    });
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (subItem && !subItem.contains(target)) {
        subItem.classList.remove("open");
        sub?.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>

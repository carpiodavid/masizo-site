---
/**
 * Footer — sitewide. Columns per docs/recon/internal-link-map.md:
 * identity + trust block (crawlable text), company links, all services,
 * contact/NAP + hours + socials. Cities render as plain text (no city
 * pages pass the photo gate yet — no dead links, anti-doorway rule).
 * Every fact imports from business.ts.
 */
import {
  ADDRESS,
  CERTIFICATIONS,
  CITIES,
  EMAIL,
  HOURS_DISPLAY,
  LEGAL_NAME,
  LICENSES,
  PHONE_DISPLAY,
  PHONE_TEL,
  SERVICES,
  SINCE_YEAR,
  SOCIAL_PROFILES,
  TRADE_NAME,
  YEARS_IN_BUSINESS,
} from "../../data/business";

const year = new Date().getFullYear();
const companyLinks = [
  { label: "Portfolio", href: "/portfolio" },
  { label: "Reviews", href: "/testimonials" },
  { label: "Service Areas", href: "/service-areas" },
  { label: "Arizona ADU Law Guide", href: "/guides/arizona-adu-law" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms & Conditions", href: "/terms-and-conditions" },
];
const cityNames = CITIES.map((c) => c.name).join(" · ");
---

<footer class="site-footer tone-agave on-dark">
  <div class="container footer-grid">
    <div class="footer-identity">
      <p class="footer-wordmark">
        <span class="footer-name">Masizo</span>
        <span class="footer-sub">Development &amp; Restorations</span>
      </p>
      <p class="footer-blurb">
        {TRADE_NAME} is a licensed Arizona general contractor and 24/7
        restoration firm based in {ADDRESS.locality}, {ADDRESS.region} —
        building, remodeling, and restoring East Valley homes since {SINCE_YEAR}.
      </p>
      <ul class="footer-trust">
        {LICENSES.map((l) => <li>{l.label}</li>)}
        {CERTIFICATIONS.map((c) => <li>{c}</li>)}
        <li>{YEARS_IN_BUSINESS} years in business</li>
      </ul>
    </div>

    <nav class="footer-col" aria-label="Company">
      <p class="footer-label">Company</p>
      <ul>
        {companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Services">
      <p class="footer-label">Services</p>
      <ul>
        <li><a href="/services">All services</a></li>
        {SERVICES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-label">Contact</p>
      <ul class="footer-contact">
        <li>{ADDRESS.locality}, {ADDRESS.region}</li>
        <li><a href={PHONE_TEL}>{PHONE_DISPLAY}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li>{HOURS_DISPLAY}</li>
      </ul>
      <p class="footer-label">Find us</p>
      <ul class="footer-social">
        {
          SOCIAL_PROFILES.map((p) => (
            <li>
              <a href={p.url} rel="noopener">
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-areas">
    <p>
      <span class="footer-areas-label">Serving the Phoenix East Valley:</span>
      {cityNames}
    </p>
  </div>

  <div class="footer-legal">
    <div class="container footer-legal-inner">
      <p>&copy; {year} {LEGAL_NAME}. All rights reserved.</p>
      <p class="footer-legal-links">
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-and-conditions">Terms</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-9);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
    padding-bottom: var(--space-7);
  }
  .footer-wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 620;
  }
  .footer-sub {
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent-on-dark);
  }
  .footer-blurb {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--text-sm);
    color: var(--c-mut-on-dark);
  }
  .footer-trust {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    max-width: 30rem;
  }
  .footer-trust li {
    font-size: var(--text-xs);
    font-weight: 560;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-bone-on-dark);
    padding-right: 0.75rem;
    margin-right: 0.75rem;
    border-right: 1px solid var(--c-line-on-dark);
  }
  .footer-trust li:last-child { border-right: 0; margin-right: 0; padding-right: 0; }

  .footer-label {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--c-accent-on-dark);
    margin-bottom: var(--space-3);
  }
  .footer-col .footer-label + .footer-label,
  .footer-col ul + .footer-label {
    margin-top: var(--space-5);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-col li { margin-bottom: 0.45rem; }
  .footer-col a {
    color: var(--c-mut-on-dark);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .footer-col a:hover { color: var(--c-bone-on-dark); }
  .footer-contact li {
    font-size: var(--text-sm);
    color: var(--c-mut-on-dark);
  }
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }

  .footer-areas {
    border-top: 1px solid var(--c-line-on-dark);
    padding-block: var(--space-5);
  }
  .footer-areas p {
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--c-mut-on-dark);
    line-height: 2;
  }
  .footer-areas-label {
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--c-bone-on-dark);
    margin-right: 0.5rem;
  }

  .footer-legal {
    background: var(--c-agave-deep);
    padding-block: var(--space-4);
  }
  .footer-legal-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .footer-legal p {
    font-size: var(--text-xs);
    color: var(--c-mut-on-dark);
  }
  .footer-legal-links { display: flex; gap: var(--space-4); }
  .footer-legal a { color: var(--c-mut-on-dark); text-decoration: none; }
  .footer-legal a:hover { color: var(--c-bone-on-dark); }

  @media (max-width: 899px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-identity { grid-column: 1 / -1; }
  }
  @media (max-width: 519px) {
    .footer-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

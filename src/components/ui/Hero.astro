---
/**
 * Hero — page-opening band. Three variants:
 *  - "home":    asymmetric editorial split — headline column + media column
 *               (slot "media", usually a PhotoPlaceholder) that bleeds to
 *               the band edge on wide screens.
 *  - "service": headline column + smaller offset media; tighter padding;
 *               expects Breadcrumbs rendered above it by the page.
 *  - "emergency": phone-first compact band for the restoration path —
 *               headline + large tap-to-call button; no media.
 *
 * Slots: default (lede paragraph/content), "heading" (optional custom H1 —
 * otherwise `title` renders as the H1), "actions", "media", "below".
 * Never a centered-H1-over-stock-photo (handoff §4 banned list).
 */
import { PHONE_DISPLAY, PHONE_TEL } from "../../data/business";

interface Props {
  variant?: "home" | "service" | "emergency";
  tone?: "bone" | "sand" | "stone" | "agave" | "clay";
  eyebrow?: string;
  title?: string;
  /** Show the big tap-to-call action automatically (emergency defaults on). */
  phone?: boolean;
}
const { variant = "home", tone = "bone", eyebrow, title, phone , headingLevel = "h1" } = Astro.props;
const dark = tone === "agave" || tone === "clay";
const showPhone = phone ?? variant === "emergency";
---

<div class:list={["hero", `hero-${variant}`, `tone-${tone}`, { "on-dark": dark }]}>
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      <slot name="heading">
        {title && headingLevel === "h2" ? <h2 class="hero-title">{title}</h2> : title && <h1 class="hero-title">{title}</h1>}
      </slot>
      <div class="hero-lede"><slot /></div>
      {
        (Astro.slots.has("actions") || showPhone) && (
          <div class="hero-actions">
            {showPhone && (
              <a class:list={["btn", dark ? "btn-bone" : "btn-clay", "hero-call"]} href={PHONE_TEL}>
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                  <path d="M3.7 1.6c.4-.4 1-.4 1.4 0l1.8 1.9c.4.4.4 1 0 1.4l-.9.9a.6.6 0 0 0-.1.7 9.6 9.6 0 0 0 3.6 3.6c.2.1.5.1.7-.1l.9-.9c.4-.4 1-.4 1.4 0l1.9 1.8c.4.4.4 1 0 1.4l-1 1.1c-.6.6-1.5.8-2.3.6C8.7 13 5.9 11.3 4 9.4 2 7.5.5 5.3 1 3.6c.2-.8 1-1.4 1.6-2l1.1 0Z" />
                </svg>
                <span>Call {PHONE_DISPLAY}</span>
              </a>
            )}
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      Astro.slots.has("media") && (
        <div class="hero-media">
          <slot name="media" />
        </div>
      )
    }
  </div>
  {
    Astro.slots.has("below") && (
      <div class="container-wide hero-below">
        <slot name="below" />
      </div>
    )
  }
</div>

<style>
  .hero {
    padding-block: clamp(3rem, 6vw, 6rem);
    overflow: clip;
  }
  .hero-service { padding-block: clamp(2.5rem, 4vw, 4.5rem); }
  .hero-emergency { padding-block: clamp(2.5rem, 4vw, 4rem); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .hero-home .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .hero-service .hero-grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
  .hero-emergency .hero-grid { grid-template-columns: minmax(0, 1fr); }

  .hero-title {
    margin-top: var(--space-4);
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    max-width: 16ch;
  }
  .hero-service .hero-title { font-size: var(--text-4xl); }
  .hero-emergency .hero-title { font-size: var(--text-4xl); max-width: 22ch; }

  .hero-lede {
    margin-top: var(--space-5);
    max-width: 52ch;
    font-size: var(--text-lg);
    color: var(--c-ink-soft);
  }
  .on-dark .hero-lede { color: var(--c-mut-on-dark); }
  /* --c-mut-on-dark is tuned for agave; on the lighter clay ground it falls
     to ~3.2:1 — use bone there (5:1 on clay) for the lede body text. */
  .tone-clay .hero-lede { color: var(--c-bone-on-dark); }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-6);
  }
  .hero-call { font-size: var(--text-base); }

  .hero-media { min-width: 0; }
  .hero-below { margin-top: clamp(2.5rem, 4vw, 4rem); }

  @media (max-width: 899px) {
    .hero-home .hero-grid,
    .hero-service .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-actions .btn { flex: 1 1 auto; }
  }
</style>

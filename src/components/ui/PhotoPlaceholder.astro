---
/**
 * PhotoPlaceholder — art-directed stand-in for owner photography (handoff §7:
 * photo library pending; placeholders must be clearly marked `[PHOTO: …]`).
 *
 * Renders a material-tone surface (soft duotone gradient + hairline frame +
 * a quiet contour motif) with a corner chip labeling the shot. When real
 * photos arrive, each instance is swapped for an <Image> with the same
 * ratio/crop — the layout is already art-directed around it.
 */
interface Props {
  /** Shot description, e.g. "finished custom home exterior, golden hour". */
  label: string;
  /** Aspect ratio, CSS syntax. */
  ratio?: "16/9" | "4/3" | "3/4" | "1/1" | "21/9" | "3/2" | "2/3";
  /** Material tone of the block. */
  tone?: "clay" | "agave" | "sand" | "stone";
  class?: string;
}
const { label, ratio = "4/3", tone = "stone", class: className = "" } = Astro.props;

const tones: Record<string, { a: string; b: string; line: string; chipBg: string; chipFg: string }> = {
  clay:  { a: "#b05c37", b: "#8a3f20", line: "rgba(246,240,228,0.28)", chipBg: "rgba(36,21,12,0.55)", chipFg: "#f6f0e4" },
  agave: { a: "#3a4f40", b: "#243329", line: "rgba(246,240,228,0.22)", chipBg: "rgba(18,26,21,0.55)", chipFg: "#f6f0e4" },
  sand:  { a: "#efe5d2", b: "#ddcfb4", line: "rgba(35,29,21,0.18)", chipBg: "rgba(250,246,238,0.8)", chipFg: "#5c5347" },
  stone: { a: "#e2d5be", b: "#c7b697", line: "rgba(35,29,21,0.18)", chipBg: "rgba(250,246,238,0.85)", chipFg: "#5c5347" },
};
const t = tones[tone];
---

<figure
  class:list={["ph", className]}
  style={`--ph-a:${t.a}; --ph-b:${t.b}; --ph-line:${t.line}; --ph-chip-bg:${t.chipBg}; --ph-chip-fg:${t.chipFg}; aspect-ratio:${ratio};`}
  role="img"
  aria-label={`Photo placeholder: ${label}`}
>
  <svg class="ph-motif" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M-20 240 C 80 180, 140 260, 240 210 S 400 230, 430 180" fill="none" stroke="var(--ph-line)" stroke-width="1" />
    <path d="M-20 270 C 90 215, 150 290, 250 245 S 410 260, 430 215" fill="none" stroke="var(--ph-line)" stroke-width="1" />
    <path d="M-20 300 C 100 250, 160 320, 260 280 S 420 290, 430 250" fill="none" stroke="var(--ph-line)" stroke-width="1" />
    <circle cx="332" cy="66" r="26" fill="none" stroke="var(--ph-line)" stroke-width="1" />
  </svg>
  <figcaption class="ph-chip">[PHOTO: {label}]</figcaption>
</figure>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin: 0;
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, var(--ph-a) 0%, var(--ph-b) 100%);
    box-shadow: inset 0 0 0 1px var(--ph-line);
  }
  .ph-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ph-chip {
    position: absolute;
    left: 10px;
    bottom: 10px;
    max-width: calc(100% - 20px);
    padding: 0.35em 0.7em;
    font-size: var(--text-xs);
    font-weight: 560;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--ph-chip-fg);
    background: var(--ph-chip-bg);
    border-radius: var(--radius-xs);
    backdrop-filter: blur(2px);
  }
</style>

---
/**
 * TrustStrip — the always-visible trust block (handoff §5): license numbers,
 * IICRC / BBB / insured, years in business — plain crawlable text, from
 * business.ts only. Renders as a quiet hairline strip; `tone` matches the
 * band it sits in.
 */
import {
  CERTIFICATIONS,
  LICENSES,
  SINCE_YEAR,
  YEARS_IN_BUSINESS,
} from "../../data/business";

interface Props {
  tone?: "bone" | "sand" | "stone" | "agave" | "clay";
  /** Hide the top hairline when the parent band brings its own. */
  flush?: boolean;
}
const { tone = "bone", flush = false } = Astro.props;
const dark = tone === "agave" || tone === "clay";
const items = [
  `${YEARS_IN_BUSINESS} years · since ${SINCE_YEAR}`,
  ...LICENSES.map((l) => l.label),
  ...CERTIFICATIONS,
];
---

<div class:list={["trust", `tone-${tone}`, { "on-dark": dark, flush }]}>
  <div class="container trust-inner">
    <ul class="trust-list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<style>
  .trust { border-block: 1px solid var(--c-line); }
  .trust.on-dark { border-color: var(--c-line-on-dark); }
  .trust.flush { border-top: 0; }
  .trust-inner { padding-block: var(--space-4); }
  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .trust-list li {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
    padding-right: var(--space-4);
    margin-right: var(--space-4);
    border-right: 1px solid var(--c-line);
    white-space: nowrap;
  }
  .trust.on-dark .trust-list li {
    color: var(--c-mut-on-dark);
    border-right-color: var(--c-line-on-dark);
  }
  .trust-list li:last-child {
    border-right: 0;
    margin-right: 0;
    padding-right: 0;
  }
</style>

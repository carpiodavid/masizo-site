---
/**
 * StickyCallBar — mobile-only (<1024px) fixed bottom bar: tap-to-call +
 * estimate link. PHONE_TEL means every tap fires GA4 call_click
 * automatically (Base.astro). Pages render this once, after <Footer>.
 * Reserves its own height so it never covers footer content.
 */
import { PHONE_DISPLAY, PHONE_TEL } from "../../data/business";
---

<div class="callbar" role="complementary" aria-label="Quick contact">
  <a class="callbar-call" href={PHONE_TEL}>
    <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
      ><path
        d="M3.7 1.6c.4-.4 1-.4 1.4 0l1.8 1.9c.4.4.4 1 0 1.4l-.9.9a.6.6 0 0 0-.1.7 9.6 9.6 0 0 0 3.6 3.6c.2.1.5.1.7-.1l.9-.9c.4-.4 1-.4 1.4 0l1.9 1.8c.4.4.4 1 0 1.4l-1 1.1c-.6.6-1.5.8-2.3.6C8.7 13 5.9 11.3 4 9.4 2 7.5.5 5.3 1 3.6c.2-.8 1-1.4 1.6-2l1.1 0Z"
      ></path></svg
    >
    <span>Call {PHONE_DISPLAY}</span>
  </a>
  <a class="callbar-estimate" href="/contact">Free estimate</a>
</div>
<div class="callbar-spacer" aria-hidden="true"></div>

<style>
  .callbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-callbar);
    display: none;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    background: var(--c-ink);
    padding-bottom: env(safe-area-inset-bottom, 0);
    box-shadow: 0 -6px 24px rgba(35, 29, 21, 0.25);
  }
  .callbar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 0.95rem 0.5rem;
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    text-decoration: none;
  }
  .callbar a svg { width: 1em; height: 1em; }
  .callbar-call {
    background: var(--c-clay);
    color: var(--c-bone-on-dark);
  }
  .callbar-call:hover { color: var(--c-bone-on-dark); }
  .callbar-estimate {
    background: var(--c-ink);
    color: var(--c-bone);
  }
  .callbar-estimate:hover { color: var(--c-bone); }
  .callbar-spacer { display: none; height: 3.4rem; }

  @media (max-width: 1023px) {
    .callbar { display: grid; }
    .callbar-spacer { display: block; }
  }
</style>
